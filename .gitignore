# OS & Disk Images (multi-gigabyte binaries)
*.img
*.img.xz
*.iso
*.bin
*.raw
*.sha

# Kernel binary artifacts (keep patches & configs, ignore large uImage binary)
os/kernel-patches/uImage.dpfix

# Logs & diagnostic dumps
*.log
*.out

# Python caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# Editor & System files
.DS_Store
*.swp
*~
.idea/
.vscode/

# SSH keys & secrets
*.key
*.pem
*id_rsa*
*id_ed25519*
*smartpc_ed25519*

# Local cache & temporary runtime files
dashboard/account-chatgpt.json

# Public router certificate authorities shipped with the LAN adapter
!dashboard/resources/iliadbox-ca.pem
