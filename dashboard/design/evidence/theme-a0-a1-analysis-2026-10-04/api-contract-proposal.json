  "requestProtocol": {
    "signature": "requestAction(actionId, targetId, arguments) for new contexts; NotificationContext1 keeps requestAction(...):bool and adds request(...) with structured result",
    "metadata": "Optional requestId in arguments; generated when absent, bound to surfaceInstanceId/generation by broker, duplicates idempotent within that instance. Notification1 adapter preserves existing call shape.",
