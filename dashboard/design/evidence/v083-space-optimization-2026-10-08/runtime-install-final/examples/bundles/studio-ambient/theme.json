{
  "schemaVersion": 1,
  "id": "studio.ambient",
  "name": "Studio Ambient",
  "version": "1.0.0",
  "extends": "base",
  "tokens": {},
  "presentations": {
    "home.now": "studio.ambient.home",
    "alerts.banner.small": "studio.ambient.small",
    "alerts.banner.large": "studio.ambient.large",
    "shell.main": "studio.ambient.shell"
  },
  "assets": [],
  "motion": {
    "navigate.family": {
      "recipe": "studio.ambient.fade",
      "durationMs": 100,
      "distancePx": 0,
      "easing": "outCubic"
    },
    "layout.swap": {
      "recipe": "studio.ambient.fade",
      "durationMs": 80,
      "distancePx": 0,
      "easing": "outCubic"
    }
  },
  "scene": {
    "enabled": false,
    "renderer": "studio.ambient.scene",
    "skin": "plain"
  },
  "iconOverrides": {
    "notification.default": {
      "backend": "component",
      "renderer": "studio.ambient.icon"
    }
  }
}
