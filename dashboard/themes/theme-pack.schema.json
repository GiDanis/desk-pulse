        }
      },
      "additionalProperties": false
    },
    "palettes": {
      "type": "object",
      "properties": {
        "day": {
          "$ref": "#/properties/tokens"
        },
        "night": {
          "$ref": "#/properties/tokens"
        }
      },
      "additionalProperties": false
    },
    "presentations": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "recipe",
          "durationMs",
          "distancePx",
          "easing"
        ],
        "properties": {
          "recipe": {
            "type": "string"
          },
          "durationMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "distancePx": {
            "type": "number",
            "minimum": 0,
            "maximum": 80
          },
          "easing": {
            "enum": [
              "linear",
              "outCubic",
              "outQuad",
              "inOutQuad"
            ]
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "renderer": {
          "type": "string"
        }
      }
    },
    "iconSetId": {
      "type": "string"
    },
    "iconApiVersion": {
      "const": 1
    },
    "iconOverrides": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "type": {
            "enum": [
              "font",
              "image",
              "data"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "enum": [
          "presentation1",
          "motion1",
          "icons1",
          "scene1"
        ]
      }
    }
  },
  "additionalProperties": false
}
