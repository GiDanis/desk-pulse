{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smartpc-theme-pack-v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "name": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors.background": {
          "type": "string",
          "default": "#101923",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.backgroundOverlay": {
          "type": "string",
          "default": "#0b1219",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.surface": {
