        },
        "typography.numbersFamily": {
          "type": "string",
          "default": "",
          "maxLength": 120
        },
        "typography.displayFamily": {
          "type": "string",
          "default": "",
          "maxLength": 120
        },
        "typography.bodyWeight": {
          "type": "integer",
          "default": 400,
          "minimum": 100,
          "maximum": 900
