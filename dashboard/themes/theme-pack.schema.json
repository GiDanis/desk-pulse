          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.textSecondary": {
          "type": "string",
          "default": "#b3c2c7",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.accent": {
          "type": "string",
          "default": "#6de0be",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.bannerSurface": {
          "type": "string",
          "default": "#29423f",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.debugSurface": {
          "type": "string",
          "default": "#273e48",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colors.demoSurface": {
          "type": "string",
          "default": "#304750",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shape.radiusCard": {
          "type": "integer",
          "default": 13,
          "minimum": 0,
          "maximum": 24
        },
        "shape.radiusRow": {
          "type": "integer",
          "default": 9,
          "minimum": 0,
          "maximum": 24
        },
        "shape.radiusPill": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "maximum": 24
        },
        "shape.radiusButton": {
          "type": "integer",
          "default": 6,
          "minimum": 0,
          "maximum": 24
        },
        "metrics.spacing": {
          "type": "integer",
          "default": 24,
          "minimum": 8,
          "maximum": 40
        },
        "metrics.listRows": {
          "type": "integer",
          "default": 4,
          "minimum": 3,
          "maximum": 4
        },
        "metrics.borderWidth": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 4
        },
        "metrics.focusWidth": {
          "type": "integer",
          "default": 3,
          "minimum": 2,
          "maximum": 4
        },
        "typography.textScale": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.85,
          "maximum": 1.1
        },
        "typography.uiFamily": {
          "type": "string",
          "default": "",
