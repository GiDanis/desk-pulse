[Unit]
Description=DeskPulse - Sync ChatGPT & Codex usage to board
After=network-online.target

[Service]
Type=oneshot
# Path can use %h (expands to user home directory) or explicit path:
ExecStart=/usr/bin/python3 %h/desk-pulse/dashboard/account_sync.py
TimeoutStartSec=35

[Install]
WantedBy=default.target
