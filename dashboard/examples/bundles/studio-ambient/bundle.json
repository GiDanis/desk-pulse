{
  "bundleFormat": 1,
  "id": "studio.ambient",
  "version": "1.0.0",
  "name": "Studio Ambient",
  "engineApi": 2,
  "contextApis": {
    "page": 2,
    "notification": 1,
    "shell": 1,
    "overlay": 1,
    "scene": 1,
    "icon": 1,
    "motion": 1
  },
  "targetProfile": "a733-960x640-eglfs",
  "qtMinimum": "6.8.2",
  "qtModules": [
    "QtQuick",
    "SmartPC.ThemeApi"
  ],
  "coverage": {
    "mode": "partial",
    "surfaces": [
      "home.now",
      "alerts.banner.small",
      "alerts.banner.large",
      "shell.main"
    ],
    "fallbacks": [
      "account.usage",
      "alerts.badge",
      "alerts.detail",
      "alerts.inbox",
      "alerts.urgent",
      "device.info",
      "home.day",
      "overlay.commands",
      "overlay.menu",
      "overlay.summary",
      "racing.calendar",
      "racing.driver.detail",
      "racing.event.detail",
      "racing.live",
      "racing.overview",
      "racing.session.detail",
      "racing.standings",
      "scene.main",
      "settings.account",
      "settings.appearance",
      "settings.appearance.notifications",
      "settings.display",
      "settings.index",
      "settings.integrations",
      "settings.modules",
      "settings.notifications",
      "settings.notifications.categories",
      "settings.notifications.quiet",
      "settings.racing",
      "settings.sources",
      "settings.sport",
      "sport.fixtures",
      "sport.match.detail",
      "sport.overview",
      "sport.standings",
      "sport.team",
      "sport.team.detail",
      "sport.team.picker",
      "weather.forecast",
      "weather.now"
    ]
  },
  "adjustments": [
    "paletteMode",
    "textScale",
    "motionMode"
  ],
  "trust": "author-code",
  "resources": [
    {
      "id": "home",
      "path": "qml/Home.qml",
      "type": "qml"
    },
    {
      "id": "small",
      "path": "qml/Small.qml",
      "type": "qml"
    },
    {
      "id": "large",
      "path": "qml/Large.qml",
      "type": "qml"
    },
    {
      "id": "scene",
      "path": "qml/Scene.qml",
      "type": "qml"
    },
    {
      "id": "icon",
      "path": "qml/Icon.qml",
      "type": "qml"
    },
    {
      "id": "motion",
      "path": "qml/Motion.qml",
      "type": "qml"
    },
    {
      "id": "shell",
      "path": "qml/Shell.qml",
      "type": "qml"
    }
  ],
  "extendedTokens": {}
}
