#!/bin/sh
set -eu

export DISPLAY=:0
export XAUTHORITY=/var/run/lightdm/root/:0

attempt=0
until /usr/bin/xset q >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 15 ]; then
        echo "X display is not available" >&2
        exit 1
    fi
    sleep 1
done

/usr/bin/xset s off -dpms

if ! /usr/bin/xrandr --query | /usr/bin/grep -q '^DP-1 connected'; then
    exit 0
fi

case "$(/usr/bin/date +%H)" in
    07|08|09|1[0-9]|20) level=1.0 ;;
    *) level=0.65 ;;
esac

/usr/bin/xrandr --output DP-1 --brightness "$level"
echo "Hagibis display brightness: $level"
